{
  "name": "functions",
  "private": true,
  "description": "MindfulJournal Cloud Functions (callable AI proxy)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:rules": "jest --config jest.rules.config.js --runInBand",
    "test:rules:emulated": "firebase emulators:exec --only firestore --project demo-rules-test --config ../firebase.json \"npm run test:rules\"",
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.10.0",
    "firebase": "^11.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
